# Copy this file to .env for local development (.env is gitignored, this
# file is not). In Vercel, set these under Project Settings -> Environment
# Variables instead of committing real values anywhere.

# Postgres connection string. If you provision Postgres from the Vercel
# dashboard (Storage tab), Vercel adds this for you automatically.
DATABASE_URL="postgresql://user:password@host:5432/database"

# Who can log into /admin. Comma-separated "Name:passcode" pairs, one per
# staff member, e.g.:
#   ADMIN_USERS="Alex:pass-alex-2026,Sam:pass-sam-8841"
# Add or remove people by editing this one line and redeploying, no code
# changes. Each person's own passcode also means the admin page can show
# who's logged in, and revoking one person doesn't require changing
# everyone else's passcode too.
ADMIN_USERS="Admin:change-me"

# Optional: email notifications when someone finishes the assessment.
# Sign up free at resend.com, create an API key, and set it here. Until
# your domain is verified in Resend (needs DNS access), NOTIFY_EMAIL
# must be the exact email address you used to sign up for Resend, that's
# a Resend platform restriction, not something this app can work around.
# Leave both blank to skip notifications entirely, nothing breaks.
RESEND_API_KEY=""
NOTIFY_EMAIL=""
# The public base URL of the deployed site, e.g.
# "https://your-project.vercel.app". Used to build the /admin link inside
# the notification email so it's clickable from a phone. Leave unset and
# the link is derived from the request's own origin instead, which is
# correct locally and on a normal Vercel deploy; set it explicitly if
# your emails ever arrive with a localhost or otherwise wrong link.
NEXT_PUBLIC_SITE_URL=""
# RESEND_FROM="WAVE Scorecard <notifications@example.com>"   # after domain verification
