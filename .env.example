# Copy this file to .env for local development (.env is gitignored, this
# file is not). In Vercel, set these under Project Settings -> Environment
# Variables instead of committing real values anywhere.

# Postgres connection string. If you provision Postgres from the Vercel
# dashboard (Storage tab), Vercel adds this for you automatically.
DATABASE_URL="postgresql://user:password@host:5432/database"

# Who can log into /admin.
#
# Simplest form: a single passcode. Whatever you set here is the passcode
# you type on the login page (the login box wants ONLY the passcode).
#   ADMIN_USERS="change-me"
#
# Multi-user form: comma-separated "Name:passcode" pairs, one per staff
# member. The part BEFORE the colon is a display name (shown as "logged
# in as"); the part AFTER the colon is what that person types to log in.
#   ADMIN_USERS="Alex:pass-alex-2026,Sam:pass-sam-8841"
# Here Alex logs in by typing "pass-alex-2026" (not "Alex:pass-alex-2026").
#
# Add or remove people by editing this one line and redeploying, no code
# changes. In a hosting dashboard (e.g. Vercel), enter the value WITHOUT
# surrounding quotes.
ADMIN_USERS="change-me"

# Optional: email notifications when someone finishes the assessment.
# Sent through Gmail's SMTP server using an App Password (NOT the
# account's normal password):
#   1. On the sending Google account, turn on 2-Step Verification.
#   2. Generate an App Password (Google Account -> Security -> App
#      passwords -> "Mail"). It's 16 characters; spaces are optional.
#   3. Put the address in GMAIL_USER and that App Password in
#      GMAIL_APP_PASSWORD.
# Unlike a transactional-email sandbox, Gmail can deliver to ANY
# recipient with no domain-verification step. Leave any of these blank to
# skip notifications entirely; nothing else breaks.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Who gets notified when someone finishes the assessment. One address, or
# several comma-separated, e.g. "owner@example.com,partner@example.com".
NOTIFY_EMAIL=""

# The public base URL of the deployed site, e.g.
# "https://your-project.vercel.app". Used to build the /admin link inside
# the notification email so it's clickable from a phone. Leave unset and
# the link is derived from the request's own origin instead, which is
# correct locally and on a normal Vercel deploy; set it explicitly if
# your emails ever arrive with a localhost or otherwise wrong link.
NEXT_PUBLIC_SITE_URL=""
