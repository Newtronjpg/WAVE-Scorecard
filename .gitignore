# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local Claude Code dev-server launch config (personal, not project config)
.claude/

# AI-agent working notes and planning docs (dev-time only, not part of the shipped project)
CLAUDE.md
AGENTS.md
docs/superpowers/
# Was only excluded by its own nested .superpowers/sdd/.gitignore, which
# covers the files under sdd/ but nothing added beside it. Ignored here so
# the rule lives with the others it belongs to.
.superpowers/

# typescript
*.tsbuildinfo
next-env.d.ts

# One-off backups written by scripts/fix-question-set.ts
question-set-backup-*.json
