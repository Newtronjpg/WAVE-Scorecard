// Prisma schema for the WAVE Scorecard assessment.
//
// Submission: each completed assessment is one row. Answers are stored
// twice, deliberately:
//   - `answers` (JSON) holds the raw {questionId: rating} map. This is the
//     source of truth and is what lets us re-score old submissions if the
//     scoring logic ever changes.
//   - The four gap scores + overall score are stored as their own columns
//     too, computed at submission time, so the admin list and the Excel
//     export are fast (no need to recompute the scoring math on every read).
//
// The remaining models (Setting, QuestionOverride, RateLimit, QuestionDraft,
// QuestionSetVersion) are described individually below, next to each one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Submission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Optional, since the assessment does not require them to start.
  prospectName String?
  companyName  String?

  // Raw answers: { "W1": 4, "W2": 2, ... } keyed by whichever question ids
  // were live when this run was scored -- the set is admin-editable, not
  // fixed, so its size and shape vary from one submission to the next.
  answers Json

  // Computed at submission time (see lib/scoring.ts). Stored so reads are
  // cheap and so a submission's displayed score never silently drifts if
  // the scoring formula changes later; re-scoring is an explicit action,
  // not an accident.
  wealthScore     Int
  accountingScore Int
  valueScore      Int
  earningsScore   Int
  overallScore    Int
  readinessBand   String

  // Optional free-text context the respondent attached to individual
  // questions: { "W1": "we sold the building in 2024", ... }, keyed by the
  // same question ids as `answers`. Only questions they actually wrote
  // about appear here.
  //
  // Null rather than {} when they wrote nothing, so "wrote nothing" has one
  // representation instead of two. Null on every row written before this
  // column existed, which is honest -- those respondents were never offered
  // the box, and a backfill would invent a silence they never chose.
  comments Json?

  // Which published question set this run answered. Null means the
  // factory default, including every run taken before versioning existed.
  questionSetVersion Int?

  // The LITERAL question set (id, gap, statement, levels, tiers) the
  // respondent was scored against, stored on the row itself -- see
  // lib/questionSet.ts's StoredQuestion/toStored. This makes every
  // submission self-describing: no join back to QuestionSetVersion is
  // ever required to know what was asked, and a null questionSetVersion
  // (the factory default) is no longer ambiguous, because the actual
  // content travels with the row regardless of whether that version
  // could later be resolved. Null on old rows written before this
  // column existed is honest -- we don't know what they saw and don't
  // backfill a guess.
  questionSetSnapshot Json?

  @@map("submissions")
}

// Editable settings, key-value so a new setting needs no schema change
// against the production database. Today: "notify_email", the
// comma-separated notification recipient list. The Setting row wins over
// the NOTIFY_EMAIL env var, which remains a fallback.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// Text overrides for the question bank, keyed by the question id in
// lib/questions.ts. Structure (which questions exist, their gap, the 1-5
// scale, each level's tier) stays in code; only wording lives here.
//
// A missing row, or a null field, falls through to the code default, so
// an empty table behaves exactly like the app did before this existed
// and "reset to default" is simply deleting the row.
model QuestionOverride {
  questionId String   @id
  statement  String?
  levels     Json?
  updatedAt  DateTime @updatedAt

  @@map("question_overrides")
}

// Fixed-window throttle counters for the public submit endpoint. One row
// per hashed client identifier; see lib/rateLimit.ts. Rows are disposable
// and can be truncated at any time.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@map("rate_limits")
}

// The single mutable working copy of the question set. Every write
// upserts against the literal id "draft", so a second row is not
// reachable through the API. Nothing here is live until it is published.
model QuestionDraft {
  id        String   @id @default("draft")
  questions Json
  updatedAt DateTime @updatedAt

  @@map("question_draft")
}

// Published snapshots, append-only. The highest version is what the
// public assessment serves. Rolling back appends a new version carrying
// an older one's content rather than deleting rows, so this stays a true
// log of what was live and when.
model QuestionSetVersion {
  version     Int      @id
  questions   Json
  note        String?
  publishedAt DateTime @default(now())
  // At most one version is ever true at a time (enforced in
  // app/api/admin/questions/versions/[version]/default/route.ts, not by
  // a DB constraint -- this table is small and admin-only, so a
  // transactional unset-then-set is simpler than a partial unique index
  // and just as safe). This is what "Reset to default" in the editor
  // actually resets to -- deliberately NOT lib/questions.ts's shipped
  // literal, which tests/scoring.test.ts pins and can never change.
  isDefault   Boolean  @default(false)

  @@map("question_set_versions")
}
